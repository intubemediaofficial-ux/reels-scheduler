# --- Core ---------------------------------------------------------------
DATABASE_URL="postgresql://reels:reels@localhost:5432/reels_scheduler?schema=public"
REDIS_URL="redis://localhost:6379"
# openssl rand -base64 32
AUTH_SECRET="replace-me"
APP_URL="http://localhost:3000"

# --- Meta (Facebook Login for Business / Instagram API) -----------------
META_APP_ID=""
META_APP_SECRET=""
# Do not hardcode in code; bump here when Meta releases a new version.
META_GRAPH_API_VERSION="v24.0"
META_OAUTH_REDIRECT_URI="http://localhost:3000/api/meta/callback"
# 32 bytes, base64. Used for AES-256-GCM encryption of OAuth tokens at rest.
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
# "mock" uses the in-process Meta sandbox adapter (no real API calls).
META_PROVIDER="mock"

# --- AI captions ---------------------------------------------------------
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
# "mock" | "openai"
AI_PROVIDER="mock"

# --- Object storage (S3 / Cloudflare R2) --------------------------------
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_OR_SIGNED_MEDIA_BASE_URL=""
# "local" stores files under ./storage for development; "s3" for production.
STORAGE_PROVIDER="local"

# --- Email / observability -----------------------------------------------
EMAIL_PROVIDER_API_KEY=""
SENTRY_DSN=""
